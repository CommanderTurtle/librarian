# Absolute path to the OKF bundle managed by Librarian.
# setup.ts defaults this to <repo>/data.
BUNDLE_ROOT=

# Native Hermes installation and isolated delegated-worker profile. Tilde paths
# are expanded by setup.ts. Override these for non-default Hermes layouts.
HERMES_HOME=~/.hermes
LIBRARIAN_PROFILE=librarian
HERMES_PROFILE_HOME=

# Python interpreter from the native Hermes installation. When empty, setup
# resolves <HERMES_HOME>/hermes-agent/venv/bin/python.
HERMES_PYTHON=

# Optional per-call overrides. Leave empty to inherit the librarian profile.
HERMES_MODEL=
HERMES_PROVIDER=

# Maximum duration of one delegated Hermes turn, in milliseconds.
HERMES_TIMEOUT_MS=600000

# Commit bundle changes when BUNDLE_ROOT is inside a Git repository.
GIT_AUTOCOMMIT=false

# Optional web/HTTP MCP server settings.
PORT=3800
# AUTH_TOKEN=
