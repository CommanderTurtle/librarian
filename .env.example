# Absolute path to the OKF bundle managed by Librarian.
# setup.ts defaults this to <repo>/data.
BUNDLE_ROOT=

# Native agent harness used for delegated Librarian turns.
# Supported values: hermes (default) or omp.
LIBRARIAN_AGENT_BACKEND=hermes

# Hermes installation and isolated delegated-worker profile. Tilde paths are
# expanded by setup.ts. These are used only by the Hermes backend.
HERMES_HOME=~/.hermes
LIBRARIAN_PROFILE=librarian
HERMES_PROFILE_HOME=
HERMES_PYTHON=
HERMES_MODEL=
HERMES_PROVIDER=
HERMES_TIMEOUT_MS=600000

# OMP's native RPC mode. OMP_COMMAND may be a command name or absolute path.
# The public memory_* server is registered in OMP_AGENT_DIR. Delegated turns
# run in the isolated OMP_PROFILE, whose config contains only librarian-okf.
OMP_COMMAND=omp
OMP_HOME=~/.omp
OMP_AGENT_DIR=~/.omp/agent
OMP_PROFILE=librarian
OMP_PROFILE_AGENT_DIR=~/.omp/profiles/librarian/agent
OMP_MODEL=
OMP_PROVIDER=
OMP_TIMEOUT_MS=600000

# Commit bundle changes when BUNDLE_ROOT is inside a Git repository.
GIT_AUTOCOMMIT=false

# Layered query memory. Exact answers are fingerprint-invalidated when bundle
# content changes. The hot layer checks recent concepts/Q&A before a deep turn.
QUERY_CACHE=true
QUERY_CACHE_TTL=24h
HOT_MEMORY=true
HOT_MEMORY_TTL=1h

# Optional autonomous consolidation for the persistent HTTP service. Empty is
# disabled; examples: 30m, 6h, 1d. Intervals below five minutes are clamped.
DREAM_INTERVAL=
DREAM_INSIGHTS=true

# Optional web/HTTP MCP server settings.
PORT=3800
# AUTH_TOKEN=
