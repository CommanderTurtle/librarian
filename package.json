{
  "name": "librarian",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes-delegated OKF librarian — MCP server and knowledge browser",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "agent:query": "bun run --filter @understory/core agent:query",
    "agent:mutate": "bun run --filter @understory/core agent:mutate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
